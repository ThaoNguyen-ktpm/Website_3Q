{
  "name": "website-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-sale-ai.mjs",
    "start": "node dist/server.js",
    "test": "vitest run && npm run test:sale-ai",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:sale-ai": "node --test src/sale-ai/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@huggingface/transformers": "4.3.1",
    "@langchain/langgraph": "1.5.1",
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.3.0",
    "unpdf": "1.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "6.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "5.0.3"
  }
}
