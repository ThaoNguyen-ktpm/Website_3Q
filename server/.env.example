DATABASE_URL="mysql://shop_user:CHANGE_ME@localhost:3306/baoq_luxury"
PORT=4000
APP_ORIGIN=http://localhost:5173
# Optional proxy hop count; enable only behind the trusted deployment proxy.
# TRUST_PROXY=1
# Google Client ID is public. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
# Private signing secret: at least 32 characters. Never commit a real secret.
SESSION_SECRET=
# Comma-separated OWNER emails initialized by seed; login uses active Staff records.
GOOGLE_ALLOWED_EMAILS=
# Only needed when SEED_SAMPLE_DATA=true.
SEED_ADMIN_EMAIL=admin@shop.test
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_PRIVATE_PASSWORD

SEED_SAMPLE_DATA=false
